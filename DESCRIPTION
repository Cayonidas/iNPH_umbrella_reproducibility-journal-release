Package: iNPHUmbrellaAnalysis
Type: Project
Title: Reproducible Analysis for the iNPH Umbrella Review
Version: 1.2.3
Authors@R: c(
    person("Caio Arruda", "Maciel", role = c("aut", "cre")),
    person("Kauã Gabriel Oliveira", "da Silva", role = "ctb"),
